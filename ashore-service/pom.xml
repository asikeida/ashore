<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.asikeida</groupId>
        <artifactId>ashore</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>ashore-service</artifactId>
    <name>Ashore Service</name>
    <description>业务域层：用户、面经、评论、通知、排行、搜索、AI。MyBatis-Plus 落库与领域事件发布。</description>

    <dependencies>
        <dependency>
            <groupId>me.asikeida</groupId>
            <artifactId>ashore-core</artifactId>
        </dependency>
        <dependency>
            <groupId>me.asikeida</groupId>
            <artifactId>ashore-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- 仅取密码哈希能力（BCrypt），不引入 Spring Security 全家桶 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 会话签发/校验（对照 paicoding 选用 auth0 java-jwt） -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>4.4.0</version>
        </dependency>
        <!-- Redis：会话登记与后续计数/排行（数据访问归属本模块，web 经传递依赖获得） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Jackson：会话身份快照的 JSON 序列化（独立于 web 引入） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- GitHub OAuth 回调的 HTTP 调用（RestClient） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- 分布式锁（足迹并发幂等，paicoding fixme 修复）；取 3.x 线末版，4.x 为新大版本线 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.52.0</version>
        </dependency>
        <!-- ES 搜索（elasticsearch-java 8.x，版本由 Spring Boot 3.5 BOM 管理；服务端 8.15.3） -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>
        <!-- Flyway：迁移脚本与依赖都归属持久化层模块（web 经传递依赖获得） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 数据访问测试的内存库（Flyway V1 在 H2 上执行验证迁移可移植性） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
