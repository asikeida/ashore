<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.asikeida</groupId>
        <artifactId>ashore</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>ashore-service</artifactId>
    <name>Ashore Service</name>
    <description>业务域层：用户、面经、评论、通知、排行、搜索、AI。MyBatis-Plus 落库与领域事件发布。</description>

    <dependencies>
        <dependency>
            <groupId>me.asikeida</groupId>
            <artifactId>ashore-core</artifactId>
        </dependency>
        <dependency>
            <groupId>me.asikeida</groupId>
            <artifactId>ashore-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Flyway：迁移脚本与依赖都归属持久化层模块（web 经传递依赖获得） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 数据访问测试的内存库（Flyway V1 在 H2 上执行验证迁移可移植性） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
