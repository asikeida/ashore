# 云端开发服务器环境变量模板（部署在服务器 ~/ashore/.env，权限 600，不入库）
# 隧道接入时本地应用读的是 ASHORE_SERVER_DB_PASSWORD（application-server.yaml），与此处 ASHORE_DB_PASSWORD 保持一致。

ASHORE_DB_NAME=ashore
ASHORE_DB_USERNAME=ashore
ASHORE_DB_PASSWORD=change-me-server
ASHORE_DB_ROOT_PASSWORD=change-me-server-root
ASHORE_DB_PORT=3306
ASHORE_REDIS_PORT=6379
