# =============================================================================
# Ashore 本地开发环境变量模板
# 复制为 .env 后按需填写；.env 不入库（.gitignore 排除 .env/.env.*），仅本机生效。
#
# 读取方有两个，取决于工作模式（两模式共用本文件，端口取值不同）：
#   ① Spring 本地后端 —— application-dev.yaml 经 spring.config.import 导入（--spring.profiles.active=dev）
#   ② 本地 Docker 三件套 —— compose.yaml 自动读取（变量替换），用于 IDEA 单测/离线开发
# =============================================================================

# ── 连接模式说明 ────────────────────────────────────────────────────────
# 模式 A（推荐）：SSH 隧道连远程共享开发库
#   先跑 scripts/dev-tunnel.sh（本地 13306→远程 MySQL 3306；16379→远程 Redis 6379）
#   端口固定填隧道映射值：ASHORE_DB_PORT=13306、ASHORE_REDIS_PORT=16379
#   密码与服务器 secrets 同源（查看命令见下方各段注释）
#
# 模式 B（离线/单测）：本地 Docker（compose.yaml 起 ashore-mysql/ashore-redis）
#   容器标准端口 3306/6379 直出宿主机，填标准端口即可
#   ⚠ 两模式互斥：切换时改本文件并重启应用；compose 建的是空库，与远程数据不同源

# ── MySQL ───────────────────────────────────────────────────────────────
# 模式 A：13306（隧道）；模式 B：3306（compose 默认映射的标准端口）
ASHORE_DB_HOST=127.0.0.1
ASHORE_DB_PORT=13306
ASHORE_DB_NAME=ashore_dev
ASHORE_DB_USERNAME=ashore_dev
# 模式 A 必填；真实值查看（管理员命令，普通开发问运维要）：
#   ssh <host> 'sudo cat <infra>/mysql/secrets/ashore_dev.env'
ASHORE_DB_PASSWORD=
# 仅模式 B 需要（compose 首次建容器时初始化 root 密码；模式 A 留空）
ASHORE_DB_ROOT_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────────────
# 模式 A：16379（隧道）；模式 B：6379（compose 默认映射的标准端口）
ASHORE_REDIS_PORT=16379
# 模式 A 必填（共享 Redis 开启了密码认证）；模式 B 本地容器无密码，留空即可。
# 真实值查看：ssh <host> 'sudo cat <infra>/redis/secrets/redis.env'
ASHORE_REDIS_PASSWORD=

# ── AI 供应商（OpenAI 兼容协议；留空 = 未启用，接口返回 503 引导文案）───
# DeepSeek：生产在用（服务器侧经部署环境变量注入），本地联调 AI 面试官必填
AI_DEEPSEEK_API_KEY=
# 备用供应商：多供应商顺序降级的第二顺位，key 过期期间留空即可
AI_ZHIPU_API_KEY=
